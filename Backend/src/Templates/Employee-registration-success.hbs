<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Welcome to Stock Management</title>
</head>
<body style="margin:0;padding:0;background:#dedad2;font-family:Arial,Helvetica,sans-serif;">

  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#dedad2;opacity:0;">
    Your Stock Management account has been created — your login details are inside.
  </div>

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#dedad2;padding:32px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#faf9f6;box-shadow:0 6px 48px rgba(0,0,0,0.18),0 1px 4px rgba(0,0,0,0.08);position:relative;">
          <tr>
            <td style="padding:52px 56px 48px;position:relative;">

              <div style="position:absolute;top:16px;left:16px;width:18px;height:18px;border-top:2px solid #d9d5cc;border-left:2px solid #d9d5cc;"></div>
              <div style="position:absolute;bottom:16px;right:16px;width:18px;height:18px;border-bottom:2px solid #d9d5cc;border-right:2px solid #d9d5cc;"></div>

              <!-- HEADER -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:2px solid #0f0f0f;padding-bottom:20px;margin-bottom:32px;">
                <tr>
                  <td>
                    <table cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="vertical-align:middle;">
                          <div style="width:40px;height:40px;background:#2563eb;display:inline-block;text-align:center;line-height:40px;">
                            <span style="font-family:Georgia,'Times New Roman',serif;color:#fff;font-size:20px;font-weight:bold;">S</span>
                          </div>
                        </td>
                        <td style="padding-left:10px;vertical-align:middle;">
                          <div style="font-family:Georgia,'Times New Roman',serif;font-size:20px;color:#0f0f0f;line-height:1;">STOCK MANAGEMENT</div>
                          <div style="font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:#6b6560;margin-top:3px;">Inventory System</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td align="right" style="vertical-align:top;">
                    <div style="font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#6b6560;">Welcome Letter</div>
                    <div style="font-size:12px;color:#6b6560;margin-top:4px;">{{year}}</div>
                  </td>
                </tr>
              </table>

              <!-- GREETING -->
              <div style="font-family:Georgia,'Times New Roman',serif;font-size:28px;color:#0f0f0f;margin-bottom:8px;">Welcome, {{firstname}} {{lastname}}!</div>
              <div style="font-size:13px;color:#3a3732;line-height:1.7;margin-bottom:32px;">
                You have been successfully registered in the <strong>Stock Management</strong> system. Your account is ready — use the credentials below to sign in for the first time.
              </div>

              <!-- SECTION 01 — CREDENTIALS -->
              <div style="border-top:1px solid #d9d5cc;padding-top:24px;margin-bottom:28px;">
                <div style="font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#d9d5cc;margin-bottom:6px;">01</div>
                <div style="font-family:Georgia,'Times New Roman',serif;font-size:22px;color:#0f0f0f;margin-bottom:16px;">Login Credentials</div>
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #d9d5cc;">
                  <tr>
                    <td style="padding:10px 14px;border-bottom:1px solid #d9d5cc;">
                      <span style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#6b6560;">Email Address</span><br>
                      <span style="font-size:14px;color:#0f0f0f;font-weight:bold;">{{email}}</span>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:14px;background:#eeebe5;">
                      <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#6b6560;margin-bottom:6px;">Temporary Password</div>
                      <div style="font-family:Georgia,'Times New Roman',serif;font-size:26px;color:#2563eb;letter-spacing:4px;">{{password}}</div>
                    </td>
                  </tr>
                </table>
              </div>

              <!-- SECTION 02 — NEXT STEPS -->
              <div style="border-top:1px solid #d9d5cc;padding-top:24px;margin-bottom:28px;">
                <div style="font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#d9d5cc;margin-bottom:6px;">02</div>
                <div style="font-family:Georgia,'Times New Roman',serif;font-size:22px;color:#0f0f0f;margin-bottom:14px;">Getting Started</div>
                <div style="padding:12px 16px;background:#fff3e0;border-left:3px solid #b45309;margin-bottom:14px;">
                  <div style="font-size:11px;color:#b45309;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;margin-bottom:4px;">Action Required</div>
                  <div style="font-size:13px;color:#3a3732;line-height:1.7;">Please log in using these credentials and change your password after your first login to keep your account secure.</div>
                </div>
              </div>

              <div style="text-align:center;color:#d9d5cc;letter-spacing:10px;font-size:10px;margin:28px 0;">· · ·</div>

              <!-- FOOTER -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #d9d5cc;padding-top:20px;margin-top:8px;">
                <tr>
                  <td style="font-family:Georgia,'Times New Roman',serif;font-size:13px;color:#0f0f0f;">STOCK MANAGEMENT</td>
                  <td align="center" style="font-size:10px;color:#6b6560;">Inventory System</td>
                  <td align="right" style="font-size:10px;color:#6b6560;">&copy; {{year}}</td>
                </tr>
              </table>

            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

</body>
</html>
