generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  RESIGNED
  PROBATION
}

enum RequisitionStatus {
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  REJECTED
}

enum ReceivingStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum UserType {
  ADMIN
  EMPLOYEE
}

enum SenderType {
  ADMIN
  EMPLOYEE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum SiteStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// ─── ADMIN ──────────────────────────────────────────

model Admin {
  id             String    @id @default(uuid())
  names          String
  email          String    @unique
  password       String
  phone          String?
  profilePicture String?
  isLocked       Boolean   @default(false)
  role           AdminRole @default(ADMIN)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("Admin")
}

model Site {
  id          String     @id @default(cuid())
  name        String
  location    String
  managerName String?
  status      SiteStatus @default(ACTIVE)
  description String?    @db.Text
  budget      Decimal    @default(0) @db.Decimal(14, 2)
  startDate   DateTime?
  endDate     DateTime?
  image       String?
  adminId     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  stocks Stock[]

  @@index([adminId])
  @@map("Site")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@map("SiteSetting")
}

// ─── EMPLOYEE ───────────────────────────────────────

model Employee {
  id             String         @id @default(uuid())
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String         @unique
  password       String
  phone          String
  position       String
  status         EmployeeStatus @default(ACTIVE)
  isLocked       Boolean        @default(false)
  profilePicture String?        @map("profile_picture")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  requisitions   Requisition[]
  permissions    EmployeePermission[]

  @@map("Employee")
}

// ─── SUPPLIER ───────────────────────────────────────

model Supplier {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?        @default("Rwanda")
  paymentTerms  String?
  rating        Float?         @default(0)
  status        SupplierStatus @default(ACTIVE)
  notes         String?        @db.Text
  adminId       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stocks Stock[]

  @@index([adminId])
  @@map("Supplier")
}

// ─── CATEGORY ───────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  adminId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks Stock[]

  @@index([adminId])
  @@map("Category")
}

// ─── STOCK ──────────────────────────────────────────

model Stock {
  id                String    @id @default(cuid())
  sku               String    @unique
  itemName          String
  categoryId        String?
  supplierId        String?
  unit              String
  quantity          Int       @default(0)
  unitCost          Decimal   @db.Decimal(12, 2)
  totalValue        Decimal   @db.Decimal(14, 2)
  warehouseLocation String
  receivedDate      DateTime
  reorderLevel      Int       @default(5)
  expiryDate        DateTime?
  description       String?   @db.Text
  stockImg          String?
  adminId           String
  siteId            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category         Category?        @relation(fields: [categoryId], references: [id])
  supplier         Supplier?        @relation(fields: [supplierId], references: [id])
  site             Site?            @relation(fields: [siteId], references: [id])
  history          StockHistory[]
  requisitionItems RequisitionItem[]

  @@index([adminId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([siteId])
  @@map("Stock")
}

// ─── STOCK HISTORY ──────────────────────────────────

model StockHistory {
  id                  String       @id @default(cuid())
  stockId             String
  movementType        MovementType
  qtyBefore           Int
  qtyChange           Int
  qtyAfter            Int
  unitPrice           Decimal?     @db.Decimal(12, 2)
  notes               String?
  createdByAdminId    String?
  createdByEmployeeId String?
  createdAt           DateTime     @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@map("StockHistory")
}

// ─── REQUISITION ────────────────────────────────────

model Requisition {
  id           String            @id @default(cuid())
  status       RequisitionStatus @default(PENDING)
  description  String?
  rejectReason String?
  employeeId   String
  approvedAt   DateTime?
  completedAt  DateTime?
  employee     Employee          @relation(fields: [employeeId], references: [id])
  items        RequisitionItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("Requisition")
}

// ─── REQUISITION ITEM ───────────────────────────────

model RequisitionItem {
  id              String          @id @default(cuid())
  requisitionId   String
  requisition     Requisition     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stockId         String?
  stock           Stock?          @relation(fields: [stockId], references: [id])
  itemName        String
  quantity        Float
  unit            String
  note            String?
  costPrice       Float?
  receivedQty     Float           @default(0)
  receivingStatus ReceivingStatus @default(NOT_RECEIVED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  receivingLogs   ReceivingLog[]

  @@map("RequisitionItem")
}

model ReceivingLog {
  id                String          @id @default(cuid())
  requisitionItemId String
  receivedQty       Float
  receivedById      String          // Admin or Employee ID — no FK constraint (dual role)
  receivedByType    String          @default("ADMIN")
  receivedByName    String?
  receivedAt        DateTime        @default(now())
  note              String?

  requisitionItem   RequisitionItem @relation(fields: [requisitionItemId], references: [id], onDelete: Cascade)

  @@map("ReceivingLog")
}

// ─── PERMISSIONS ────────────────────────────────────

model Permission {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  employees   EmployeePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("Permission")
}

model EmployeePermission {
  id           String     @id @default(uuid())
  employeeId   String
  permissionId String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([employeeId, permissionId])
  @@map("EmployeePermission")
}

// ─── NOTIFICATIONS ──────────────────────────────────

model Notification {
  id         String      @id @default(cuid())
  recipients Json
  senderId   String?
  senderType SenderType?
  title      String
  message    String
  link       String?
  createdAt  DateTime    @default(now())

  @@map("Notification")
}

// ─── PUSH SUBSCRIPTIONS ─────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  type      UserType
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now())

  @@unique([endpoint(length: 255)])
  @@index([userId, type])
  @@map("PushSubscription")
}
