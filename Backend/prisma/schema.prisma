generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  RESIGNED
  PROBATION
}

enum RequisitionStatus {
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  REJECTED
}

enum ReceivingStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum UserType {
  ADMIN
  EMPLOYEE
}

enum SenderType {
  ADMIN
  EMPLOYEE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  MIGRATION_OUT
  MIGRATION_IN
}

enum StockMigrationStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
  REJECTED
}

enum StockType {
  MATERIAL
  EQUIPMENT
}

enum StockOutStatus {
  OUT
  RETURNED
}

enum SiteStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum PaymentType {
  CREDIT
  DEBIT
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum PurchaseOrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

// ─── ADMIN ──────────────────────────────────────────

model Admin {
  id             String    @id @default(uuid())
  names          String
  email          String    @unique
  password       String
  phone          String?
  profilePicture String?
  isLocked       Boolean   @default(false)
  role           AdminRole @default(ADMIN)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("Admin")
}

model Site {
  id          String     @id @default(cuid())
  name        String
  location    String
  managerName String?
  status      SiteStatus @default(ACTIVE)
  description String?    @db.Text
  budget      Decimal    @default(0) @db.Decimal(14, 2)
  startDate   DateTime?
  endDate     DateTime?
  image       String?
  adminId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  stocks        Stock[]
  workerRecords SiteWorkerRecord[]
  expenses      SiteExpense[]
  requisitions  Requisition[]
  stockOuts     StockOut[]
  siteAccess    SiteEmployeeAccess[]
  migrationsOut  StockMigration[]     @relation("MigrationSourceSite")
  migrationsIn   StockMigration[]     @relation("MigrationDestSite")
  purchaseOrders PurchaseOrder[]

  @@index([adminId])
  @@map("Site")
}

model WorkerCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  adminId   String?
  createdAt DateTime @default(now())

  records SiteWorkerRecord[]

  @@map("WorkerCategory")
}

model SiteWorkerRecord {
  id          String   @id @default(cuid())
  siteId      String
  date        DateTime @default(now())
  workerCount Int
  notes       String?  @db.Text
  recordedBy  String
  adminId     String?
  categoryId  String?
  createdAt   DateTime @default(now())

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category WorkerCategory? @relation(fields: [categoryId], references: [id])

  @@index([siteId])
  @@index([categoryId])
  @@map("SiteWorkerRecord")
}

model SiteExpense {
  id          String   @id @default(cuid())
  siteId      String
  description String
  amount      Decimal  @db.Decimal(14, 2)
  category    String?
  date        DateTime @default(now())
  reference   String?
  notes       String?  @db.Text
  adminId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("SiteExpense")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@map("SiteSetting")
}

// ─── EMPLOYEE ───────────────────────────────────────

model Employee {
  id                 String         @id @default(uuid())
  firstName          String         @map("first_name")
  lastName           String         @map("last_name")
  email              String         @unique
  password           String
  phone              String
  position           String
  status             EmployeeStatus @default(ACTIVE)
  isLocked           Boolean        @default(false)
  profilePicture     String?        @map("profile_picture")
  idCardImage        String?        @map("id_card_image")
  cvDocument         String?        @map("cv_document")
  supportingDocument String?        @map("supporting_document")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?      @map("deleted_at")

  requisitions Requisition[]
  permissions  EmployeePermission[]
  siteAccess   SiteEmployeeAccess[]

  @@map("Employee")
}

// ─── SUPPLIER ───────────────────────────────────────

model Supplier {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?        @default("Rwanda")
  paymentTerms  String?
  rating        Float?         @default(0)
  status        SupplierStatus @default(ACTIVE)
  notes         String?        @db.Text
  adminId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stockSuppliers StockSupplier[]
  payments       SupplierPayment[]
  requisitions   Requisition[]
  purchaseOrders PurchaseOrder[]

  @@index([adminId])
  @@map("Supplier")
}

// ─── CATEGORY ───────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  adminId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks             Stock[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([adminId])
  @@map("Category")
}

// ─── STOCK ──────────────────────────────────────────

model Stock {
  id                String    @id @default(cuid())
  sku               String    @unique
  itemName          String
  categoryId        String?
  unit              String
  quantity          Int       @default(0)
  unitCost          Decimal   @db.Decimal(12, 2)
  totalValue        Decimal   @db.Decimal(14, 2)
  warehouseLocation String?
  receivedDate      DateTime
  reorderLevel      Int       @default(5)
  expiryDate        DateTime?
  description       String?   @db.Text
  stockImg          String?
  adminId           String
  siteId            String?
  stockType         StockType @default(MATERIAL)
  quantityOut       Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  category         Category?         @relation(fields: [categoryId], references: [id])
  site             Site?             @relation(fields: [siteId], references: [id])
  history          StockHistory[]
  requisitionItems RequisitionItem[]
  payments         SupplierPayment[]
  stockOuts        StockOut[]
  stockSuppliers   StockSupplier[]
  migrationsOut      StockMigration[]    @relation("MigrationSourceStock")
  migrationsIn       StockMigration[]    @relation("MigrationDestStock")
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([itemName, siteId])
  @@index([adminId])
  @@index([categoryId])
  @@index([siteId])
  @@map("Stock")
}

// ─── STOCK HISTORY ──────────────────────────────────

model StockHistory {
  id                  String       @id @default(cuid())
  stockId             String
  movementType        MovementType
  qtyBefore           Int
  qtyChange           Int
  qtyAfter            Int
  unitPrice           Decimal?     @db.Decimal(12, 2)
  notes               String?
  createdByAdminId    String?
  createdByEmployeeId String?
  siteId              String?
  migrationId         String?
  createdAt           DateTime     @default(now())

  stock     Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)
  migration StockMigration? @relation(fields: [migrationId], references: [id])

  @@index([stockId])
  @@index([migrationId])
  @@map("StockHistory")
}

// ─── STOCK MIGRATION ────────────────────────────────

model StockMigration {
  id                  String               @id @default(cuid())
  stockId             String
  sourceSiteId        String
  destinationSiteId   String
  destinationStockId  String?
  quantity            Float
  unit                String
  unitCostAtMigration Decimal              @db.Decimal(12, 2)
  status              StockMigrationStatus @default(IN_TRANSIT)
  instant             Boolean              @default(false)
  notes               String?              @db.Text
  cancelReason        String?              @db.Text
  initiatedById       String
  initiatedByType     String
  initiatedByName     String?
  receivedById        String?
  receivedByType      String?
  receivedByName      String?
  dispatchedAt        DateTime             @default(now())
  receivedAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  stock            Stock          @relation("MigrationSourceStock", fields: [stockId], references: [id])
  destinationStock Stock?         @relation("MigrationDestStock", fields: [destinationStockId], references: [id])
  sourceSite       Site           @relation("MigrationSourceSite", fields: [sourceSiteId], references: [id])
  destinationSite  Site           @relation("MigrationDestSite", fields: [destinationSiteId], references: [id])
  history          StockHistory[]

  @@index([sourceSiteId])
  @@index([destinationSiteId])
  @@index([stockId])
  @@map("StockMigration")
}

// ─── REQUISITION ────────────────────────────────────

model Requisition {
  id               String            @id @default(cuid())
  status           RequisitionStatus @default(PENDING)
  description      String?
  rejectReason     String?
  employeeId       String?
  createdByAdminId String?
  supplierId       String?
  siteId           String?
  approvedAt       DateTime?
  completedAt      DateTime?
  employee         Employee?         @relation(fields: [employeeId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  site             Site?             @relation(fields: [siteId], references: [id])
  items            RequisitionItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([supplierId])
  @@index([employeeId])
  @@index([siteId])
  @@map("Requisition")
}

// ─── REQUISITION ITEM ───────────────────────────────

model RequisitionItem {
  id              String          @id @default(cuid())
  requisitionId   String
  requisition     Requisition     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stockId         String?
  stock           Stock?          @relation(fields: [stockId], references: [id])
  itemName        String
  quantity        Float
  unit            String
  note            String?
  costPrice       Float?
  receivedQty     Float           @default(0)
  receivingStatus ReceivingStatus @default(NOT_RECEIVED)
  paymentType     String          @default("NONE")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  receivingLogs ReceivingLog[]
  payments      SupplierPayment[]

  @@map("RequisitionItem")
}

model ReceivingLog {
  id                String   @id @default(cuid())
  requisitionItemId String
  receivedQty       Float
  receivedById      String // Admin or Employee ID — no FK constraint (dual role)
  receivedByType    String   @default("ADMIN")
  receivedByName    String?
  receivedAt        DateTime @default(now())
  note              String?

  requisitionItem RequisitionItem @relation(fields: [requisitionItemId], references: [id], onDelete: Cascade)

  @@map("ReceivingLog")
}

// ─── PURCHASE ORDERS ────────────────────────────────

model PurchaseOrder {
  id               String              @id @default(cuid())
  supplierId       String
  siteId           String?
  reference        String?             @unique
  status           PurchaseOrderStatus @default(PENDING)
  notes            String?             @db.Text
  createdByAdminId String
  date             DateTime            @default(now())
  expectedDate     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  site     Site?               @relation(fields: [siteId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([siteId])
  @@map("PurchaseOrder")
}

model PurchaseOrderItem {
  id              String          @id @default(cuid())
  purchaseOrderId String
  stockId         String?
  categoryId      String?
  itemName        String
  description     String?         @db.Text
  quantity        Decimal         @db.Decimal(14, 4)
  unit            String?
  unitCost        Decimal?        @db.Decimal(14, 2)
  receivedQty     Decimal         @default(0) @db.Decimal(14, 4)
  receivingStatus ReceivingStatus @default(NOT_RECEIVED)
  paymentType     String          @default("NONE")
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stock         Stock?            @relation(fields: [stockId], references: [id])
  category      Category?         @relation(fields: [categoryId], references: [id])
  payments      SupplierPayment[]

  @@index([purchaseOrderId])
  @@index([stockId])
  @@index([categoryId])
  @@map("PurchaseOrderItem")
}

// ─── PERMISSIONS ────────────────────────────────────

model Permission {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  employees   EmployeePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("Permission")
}

model EmployeePermission {
  id           String     @id @default(uuid())
  employeeId   String
  permissionId String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([employeeId, permissionId])
  @@map("EmployeePermission")
}

// ─── NOTIFICATIONS ──────────────────────────────────

model Notification {
  id         String      @id @default(cuid())
  recipients Json
  senderId   String?
  senderType SenderType?
  title      String
  message    String
  link       String?
  createdAt  DateTime    @default(now())

  @@map("Notification")
}

// ─── UNITS ──────────────────────────────────────────

model Unit {
  id        String   @id @default(cuid())
  name      String
  adminId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, adminId])
  @@index([adminId])
  @@map("Unit")
}

// ─── SUPPLIER PAYMENTS ──────────────────────────────

model SupplierPayment {
  id                String         @id @default(cuid())
  supplierId          String
  stockId             String?
  requisitionItemId   String?
  purchaseOrderItemId String?
  type                PaymentType
  amount            Decimal        @db.Decimal(14, 2)
  quantity          Decimal?       @db.Decimal(14, 4)
  reference         String?        @db.Text
  notes             String?        @db.Text
  date              DateTime       @default(now())
  adminId           String
  status            PaymentStatus? @default(UNPAID)
  paidAmount        Decimal        @default(0) @db.Decimal(14, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  supplier          Supplier           @relation(fields: [supplierId], references: [id])
  stock             Stock?             @relation(fields: [stockId], references: [id])
  requisitionItem   RequisitionItem?   @relation(fields: [requisitionItemId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([supplierId])
  @@index([stockId])
  @@index([requisitionItemId])
  @@index([purchaseOrderItemId])
  @@map("SupplierPayment")
}

// ─── STOCK SUPPLIER ─────────────────────────────────

model StockSupplier {
  id         String @id @default(cuid())
  stockId    String
  supplierId String

  stock    Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([stockId, supplierId])
  @@index([stockId])
  @@index([supplierId])
  @@map("StockSupplier")
}

// ─── ACTIVITY LOG ───────────────────────────────────

model ActivityLog {
  id              String   @id @default(cuid())
  action          String // e.g. STOCK_CREATED, REQUISITION_APPROVED
  entityType      String // e.g. Stock, Employee, Requisition
  entityId        String?
  entityLabel     String? // human-readable name/title of the entity
  performedById   String
  performedByType String // ADMIN | EMPLOYEE
  performedByName String?
  metadata        Json? // extra context (before/after values, counts, etc.)
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([createdAt])
  @@map("ActivityLog")
}

// ─── IMPORT SNAPSHOT ────────────────────────────────

model ImportSnapshot {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  performedById    String
  performedByName  String
  fileName         String    @default("backup.json")
  strategy         String    @default("SKIP")
  groups           Json?
  summary          Json
  createdIds       Json
  status           String    @default("active")
  rolledBackAt     DateTime?
  rolledBackById   String?
  rolledBackByName String?

  @@map("ImportSnapshot")
}

// ─── PUSH SUBSCRIPTIONS ─────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  type      UserType
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now())

  @@unique([endpoint(length: 255)])
  @@index([userId, type])
  @@map("PushSubscription")
}

// ─── STOCK OUT ───────────────────────────────────────

model StockOut {
  id             String         @id @default(cuid())
  siteId         String
  stockId        String
  quantity       Float
  unit           String
  notes          String?        @db.Text
  date           DateTime       @default(now())
  recordedById   String
  recordedByType String         @default("ADMIN")
  recordedByName String?
  status         StockOutStatus @default(OUT)
  returnedAt     DateTime?
  returnNotes    String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id])

  @@index([siteId])
  @@index([stockId])
  @@map("StockOut")
}

// ─── SITE EMPLOYEE ACCESS ────────────────────────────

model SiteEmployeeAccess {
  id                String   @id @default(cuid())
  siteId            String
  employeeId        String
  canManageInfo     Boolean  @default(false)
  canManageWorkers  Boolean  @default(false)
  canManageExpenses Boolean  @default(false)
  canManageStock    Boolean  @default(false)
  canManageStockOut Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([siteId, employeeId])
  @@index([siteId])
  @@index([employeeId])
  @@map("SiteEmployeeAccess")
}
